# ---- KOHA ----
# Base URL of the KOHA installation (no trailing slash).
KOHA_BASE_URL=https://catalog.nfsu.ac.in
# Catalogue search backend: "rss" (unauthenticated OPAC feed, default) or "rest".
SEARCH_BACKEND=rss
# Only required when SEARCH_BACKEND=rest.
KOHA_API_USER=
KOHA_API_PASS=
# Number of catalogue records to return per query.
MAX_RESULTS=5
# Request timeout (seconds) for KOHA calls.
KOHA_TIMEOUT=20

# ---- LLM (Ollama) ----
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT=120

# ---- Prompt-injection guard ----
GUARD_ENABLED=true
GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-86M
GUARD_THRESHOLD=0.5

# ---- Service ----
# Master switch surfaced to the frontend so it can enable/disable the widget.
CHATBOT_ENABLED=true
# Comma-separated list of origins allowed to call the API (OPAC + local dev).
ALLOWED_ORIGINS=*
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO
